{# One demo order row. Set order before the include; withSelect adds the selection checkbox. #}
<tr>
    {%- if withSelect %}
    <td><input class="check" type="checkbox" id="select-{{ order.id }}" aria-label="Select {{ order.id }}"></td>
    {%- endif %}
    <td class="text-nowrap"><a href="#" class="fw-bold">{{ order.id }}</a></td>
    <td>
        <div class="d-flex align-items-center gap-3">
            <span class="avatar avatar-sm"><img class="avatar-img" src="assets/images/avatars/{{ order.avatar }}.jpg" alt=""></span>
            <div class="lh-sm">
                <div class="fw-bold fg-body">{{ order.name }}</div>
                <div class="small fg-2">{{ order.email }}</div>
            </div>
        </div>
    </td>
    <td><span class="badge theme-{{ order.color }}">{{ order.status }}</span></td>
    <td data-order="{{ order.isoDate }}" class="text-nowrap">{{ order.date }}</td>
    <td data-order="{{ order.cents }}" class="text-end text-nowrap aui-number">{{ order.amount }}</td>
    <td class="text-end">
        <button type="button" class="btn-text btn-icon btn-sm theme-secondary" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" aria-label="Actions for {{ order.id }}"><i data-lucide="ellipsis"></i></button>
        <div class="menu">
            <a class="menu-item" href="#"><i data-lucide="eye"></i>View</a>
            <a class="menu-item" href="#"><i data-lucide="printer"></i>Print invoice</a>
            <hr class="menu-divider">
            <a class="menu-item theme-danger" href="#"><i data-lucide="x"></i>Cancel order</a>
        </div>
    </td>
</tr>
