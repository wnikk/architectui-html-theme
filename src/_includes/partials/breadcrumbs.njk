{#- Path of a page in the menu (the breadcrumbsFor filter): the home link, the heading and the parent item
    as Menus with the pages of their level, then the current page. The header and the page title use it.
    Bootstrap 6 breadcrumb: .breadcrumb-link items and explicit .breadcrumb-divider elements between them. #}
{%- macro trail(crumbs, stem) %}
<ol class="breadcrumb">
    <li><a class="breadcrumb-link" href="index.html" aria-label="Home"><i data-lucide="house"></i></a></li>
    {%- for crumb in crumbs %}
    <li class="breadcrumb-divider" aria-hidden="true"></li>
    {%- if loop.last %}
    <li><span class="breadcrumb-link active" aria-current="page">{{ crumb.title }}</span></li>
    {%- else %}
    <li>
        <a href="#" class="breadcrumb-link" role="button" data-bs-toggle="menu" aria-expanded="false">{{ crumb.title }}<i data-lucide="chevron-down"></i></a>
        <div class="menu">
            {%- for link in crumb.links %}
            <a class="menu-item{% if link.href | isActive(stem) %} active{% endif %}" href="{{ link.href }}"{% if link.href | isActive(stem) %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endfor %}
        </div>
    </li>
    {%- endif %}
    {%- endfor %}
</ol>
{%- endmacro %}
