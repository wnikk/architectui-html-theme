<div class="aui-expand me-3" role="search" data-aui-expand>
    <input type="search" class="form-control" placeholder="Type to search" aria-label="Search">
    <button type="button" class="btn" data-aui-expand-toggle aria-label="Search"></button>
    <button type="button" class="btn-close" data-aui-expand-close aria-label="Close search"></button>
</div>
{#- A page with "breadcrumbs: header" in its front matter shows its path in the menu here; other pages show the quick links. #}
{%- from "partials/breadcrumbs.njk" import trail %}
{%- set crumbs = (menu | breadcrumbsFor(page.filePathStem)) if breadcrumbs == "header" else [] %}
{%- if crumbs.length %}
<nav class="d-none d-md-block" aria-label="breadcrumb">
    {{- trail(crumbs, page.filePathStem) }}
</nav>
{%- else %}
<ul class="navbar-nav d-none d-md-flex">
    <li class="nav-item">
        <a href="#" class="nav-link"><i data-lucide="database" class="me-2"></i>Statistics</a>
    </li>
    <li class="nav-item">
        <a href="#" class="nav-link"><i data-lucide="square-pen" class="me-2"></i>Projects</a>
    </li>
    <li class="nav-item">
        <a href="#" class="nav-link"><i data-lucide="settings" class="me-2"></i>Settings</a>
    </li>
</ul>
{%- endif %}
