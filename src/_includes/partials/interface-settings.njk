{# Interface settings: every control with data-aui-setting sets an attribute on <html> and is stored in localStorage (architectui.js).
   Put it in a card or a section of a page; "prefix" keeps the ids and radio names unique on the page.
   Bootstrap 6 controls: switches in form fields, toggle buttons as labels with the input inside. #}
{%- set prefix = prefix or "ui" %}
{%- set schemes = ["", "primary", "accent", "success", "info", "warning", "danger", "secondary", "inverse", "focus"] %}
<div class="row g-7">
    <div class="lg:col-6">
        <h6 class="mb-5">Layout</h6>
        {%- for opt in [["header", "Fixed header", "The header stays at the top while the page scrolls."], ["sidebar", "Fixed sidebar", "The sidebar stays on the left while the page scrolls."], ["footer", "Fixed footer", "The footer stays at the bottom of the window."]] %}
        <div class="form-field mb-5">
            <div class="switch">
                <input type="checkbox" role="switch" switch id="{{ prefix }}-setting-{{ opt[0] }}" data-aui-setting="{{ opt[0] }}" value="fixed" data-aui-off="static">
            </div>
            <label for="{{ prefix }}-setting-{{ opt[0] }}">
                <span class="d-block fw-bold">{{ opt[1] }}</span>
                <span class="small fg-2">{{ opt[2] }}</span>
            </label>
        </div>
        {%- endfor %}
    </div>
    <div class="lg:col-6">
        <h6 class="mb-5">Mode</h6>
        <div class="btn-group mb-7" role="radiogroup" aria-label="Color mode">
            {%- for mode in [["light", "Light"], ["dark", "Dark"], ["system", "System"]] %}
            <label class="btn-check btn-outline btn-sm theme-primary"><input type="radio" name="{{ prefix }}-mode" value="{{ mode[0] }}" data-aui-setting="mode">{{ mode[1] }}</label>
            {%- endfor %}
        </div>
        <h6 class="mb-5">Density</h6>
        <div class="btn-group mb-7" role="radiogroup" aria-label="Density">
            <label class="btn-check btn-outline btn-sm theme-primary"><input type="radio" name="{{ prefix }}-density" value="" data-aui-setting="density">Comfortable</label>
            <label class="btn-check btn-outline btn-sm theme-primary"><input type="radio" name="{{ prefix }}-density" value="compact" data-aui-setting="density">Compact</label>
        </div>
        <h6 class="mb-5">Page section tabs</h6>
        <div class="btn-group" role="radiogroup" aria-label="Page section tabs">
            <label class="btn-check btn-outline btn-sm theme-primary"><input type="radio" name="{{ prefix }}-tabs" value="shadow" data-aui-setting="tabs">Shadow</label>
            <label class="btn-check btn-outline btn-sm theme-primary"><input type="radio" name="{{ prefix }}-tabs" value="line" data-aui-setting="tabs">Line</label>
        </div>
    </div>
    <div class="col-12">
        <h6 class="mb-5">Theme</h6>
        <div class="d-flex flex-wrap gap-7" role="radiogroup" aria-label="Theme">
            {%- for theme in themes %}
            <label class="aui-theme-option">
                <input type="radio" name="{{ prefix }}-theme" value="{{ theme.id }}" data-aui-setting="theme">
                <span style="--aui-dot-brand: {{ theme.brand }}; --aui-dot-accent: {{ theme.accent }}"></span>
                <span>{{ theme.name }}{% if theme.darkOnly %}<br><small>dark only</small>{% endif %}</span>
            </label>
            {%- endfor %}
        </div>
    </div>
    {%- for part in [["header-scheme", "Header color"], ["sidebar-scheme", "Sidebar color"]] %}
    <div class="lg:col-6">
        <h6 class="mb-5">{{ part[1] }}</h6>
        <div class="d-flex flex-wrap gap-3" role="radiogroup" aria-label="{{ part[1] }}">
            {%- for name in schemes %}
            <label class="aui-swatch aui-swatch--{{ name or 'default' }}" title="{{ name or 'default' }}"><input type="radio" name="{{ prefix }}-{{ part[0] }}" value="{{ name }}" data-aui-setting="{{ part[0] }}"><span class="visually-hidden">{{ name or "default" }}</span></label>
            {%- endfor %}
        </div>
    </div>
    {%- endfor %}
</div>
