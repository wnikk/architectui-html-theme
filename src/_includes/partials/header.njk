<header class="aui-header">
    <div class="aui-header__brand">
        <button type="button" class="aui-burger aui-header__mobile-toggle" data-bs-toggle="offcanvas" data-bs-target="#auiSidebar" aria-controls="auiSidebar" aria-expanded="false" aria-label="Open menu"><span><span></span></span></button>
        {% include "partials/logo.njk" %}
        <button type="button" class="aui-burger aui-header__collapse" data-aui-toggle="sidebar" aria-pressed="false" aria-label="Collapse menu"><span><span></span></span></button>
        <button type="button" class="btn btn-primary btn-sm aui-header__more" data-bs-toggle="collapse" data-bs-target="#auiHeaderContent" aria-controls="auiHeaderContent" aria-expanded="false" aria-label="Show header menu"><i data-lucide="ellipsis-vertical"></i></button>
    </div>
    <div class="aui-header__content collapse" id="auiHeaderContent">
        <div class="aui-header__left">
            {% include "partials/header-left.njk" %}
        </div>
        <div class="aui-header__right">
            {% include "partials/header-right.njk" %}
        </div>
    </div>
</header>
