{#- Page title actions of the Invoice page. data-aui-print opens the print dialog; print:d-none keeps them off paper. #}
<div class="md:ms-auto mt-5 md:mt-0 d-flex justify-content-center gap-3 print:d-none">
    <button type="button" class="btn-outline theme-secondary" data-bs-toggle="tooltip" title="A demo: nothing is sent"><i data-lucide="send"></i>Send</button>
    <button type="button" class="btn-solid theme-primary shadow-sm shadow-primary" data-aui-print><i data-lucide="printer"></i>Print</button>
</div>
