{#- One Kanban card. Set card and columns before the include. The "Move to" menu is the way to move a card
    with the keyboard or on a touch screen; with a mouse the card is dragged. #}
<article class="card aui-kanban-card" draggable="true" tabindex="0" data-card="{{ card.id }}" data-labels="{% for label in card.labels %}{{ label[0] }} {% endfor %}" aria-label="{{ card.title }}">
    <div class="card-body p-5 gap-3">
        <div class="d-flex align-items-start gap-3">
            <div class="d-flex flex-wrap gap-1 flex-grow-1">
                {%- for label in card.labels %}
                <span class="badge badge-subtle theme-{{ label[1] }}">{{ label[0] }}</span>
                {%- endfor %}
            </div>
            <div>
                <button type="button" class="btn-text btn-icon btn-xs theme-secondary" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" aria-label="Card actions"><i data-lucide="ellipsis"></i></button>
                <div class="menu">
                    <h6 class="menu-header">Move to</h6>
                    {%- for column in columns %}
                    <button type="button" class="menu-item" data-move-to="{{ column.id }}"{% if column.id == card.column %} disabled{% endif %}>{{ column.title }}</button>
                    {%- endfor %}
                </div>
            </div>
        </div>
        <h6 class="fg-body lh-sm" data-card-title>{{ card.title }}</h6>
        {%- if card.checklist %}
        <div class="d-flex align-items-center gap-3 small fg-2">
            <i data-lucide="list-checks"></i><span class="aui-number">{{ card.checklist[0] }}/{{ card.checklist[1] }}</span>
            <div class="progress flex-grow-1{% if card.checklist[0] == card.checklist[1] %} theme-success{% endif %}" role="progressbar" aria-label="Checklist" aria-valuenow="{{ card.checklist[0] }}" aria-valuemin="0" aria-valuemax="{{ card.checklist[1] }}" style="height: .25rem">
                <div class="progress-bar" style="width: {{ (card.checklist[0] / card.checklist[1] * 100) | round }}%"></div>
            </div>
        </div>
        {%- endif %}
        <div class="d-flex align-items-center gap-5 small fg-2">
            {%- if card.due %}
            <span class="d-inline-flex align-items-center gap-1{% if card.overdue %} fg-danger fw-bold{% endif %}"><i data-lucide="calendar"></i>{{ card.due }}</span>
            {%- endif %}
            {%- if card.comments %}
            <span class="d-inline-flex align-items-center gap-1"><i data-lucide="message-square"></i>{{ card.comments }}</span>
            {%- endif %}
            {%- if card.files %}
            <span class="d-inline-flex align-items-center gap-1"><i data-lucide="paperclip"></i>{{ card.files }}</span>
            {%- endif %}
            <span class="avatar-stack avatar-stack-xs ms-auto">
                {%- for avatar in card.avatars %}
                <span class="avatar"><img class="avatar-img" src="assets/images/avatars/{{ avatar }}.jpg" alt=""></span>
                {%- endfor %}
            </span>
        </div>
    </div>
</article>
