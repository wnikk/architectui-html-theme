{# Verification code: the Bootstrap 6 OTP input, one real text field drawn as six digit slots (OtpInput plugin).
   architectui-auth.js reads its value and listens to complete.bs.otpInput. Set otpId before the include. #}
<div class="otp otp-connected d-flex justify-content-center" data-bs-otp data-aui-otp>
    <input type="text" class="otp-input" id="{{ otpId }}" maxlength="6" inputmode="numeric" autocomplete="one-time-code" aria-label="Verification code">
</div>
