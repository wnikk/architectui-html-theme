<button type="button" class="aui-mode-toggle me-3" data-aui-toggle="mode" aria-label="Toggle light and dark mode">
    <i data-lucide="moon" class="aui-mode-toggle__dark"></i>
    <i data-lucide="sun" class="aui-mode-toggle__light"></i>
</button>
<div class="aui-user">
    <div class="dropdown">
        <a class="aui-user__toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
            <img src="assets/images/avatars/1.jpg" width="42" height="42" class="rounded-circle" alt="">
            <i data-lucide="chevron-down" class="ms-2 aui-opacity-80"></i>
        </a>
        <div class="dropdown-menu dropdown-menu-end">
            <button type="button" class="dropdown-item">User Account</button>
            <button type="button" class="dropdown-item">Settings</button>
            <h6 class="dropdown-header">Header</h6>
            <button type="button" class="dropdown-item">Actions</button>
            <div class="dropdown-divider"></div>
            <button type="button" class="dropdown-item">Dividers</button>
        </div>
    </div>
    <div class="aui-user__info">
        <div class="aui-user__name">Alina Mclourd</div>
        <div class="aui-user__role">VP People Manager</div>
    </div>
    <button type="button" class="btn btn-primary btn-sm aui-btn-shadow p-1 aui-user__action" data-aui-toast="#auiCalendarToast" aria-label="Calendar"><i data-lucide="calendar" class="mx-1"></i></button>
</div>
