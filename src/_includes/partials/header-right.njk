<span class="badge theme-success d-none lg:d-inline-flex"><i data-lucide="activity"></i>All systems normal</span>
{#- The bell: the unread count of the Notifications page (apps-notifications.js keeps it current there).
    The count sits on the top right corner (frame/_header.scss); the button keeps room for two digits. #}
<a class="aui-header-btn" href="apps-notifications.html" aria-label="Notifications, {{ notifications.unread }} unread">
    <i data-lucide="bell"></i>
    <span class="badge theme-danger" data-notification-count aria-hidden="true">{{ notifications.unread }}</span>
</a>
{#- Mode toggle and the theme list: one group. Each theme is a Menu item button with data-aui-setting="theme". #}
<div class="aui-theme-switch">
    <button type="button" class="aui-mode-toggle" data-aui-toggle="mode" aria-label="Toggle light and dark mode">
        <i data-lucide="moon"></i>
        <i data-lucide="sun"></i>
    </button>
    <button type="button" class="aui-mode-toggle" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" aria-label="Choose a theme"><i data-lucide="chevron-down"></i></button>
    <div class="menu">
        <h6 class="menu-header">Theme</h6>
        {%- for theme in themes %}
        <button type="button" class="menu-item" data-aui-setting="theme" value="{{ theme.id }}">
            <span class="aui-theme-dot" style="--aui-dot-brand: {{ theme.brand }}; --aui-dot-accent: {{ theme.accent }}"></span>
            <span>{{ theme.name }}</span>
            {%- if theme.darkOnly %}
            <small class="opacity-75">dark only</small>
            {%- endif %}
            <i data-lucide="check" class="ms-auto aui-theme-check"></i>
        </button>
        {%- endfor %}
        <hr class="menu-divider">
        <a class="menu-item" href="pages-profile.html#interface"><i data-lucide="sliders-horizontal"></i>All interface settings</a>
    </div>
</div>
<div>
    <a class="d-inline-flex align-items-center fg-reset text-decoration-none" href="#" role="button" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" aria-label="User menu">
        <span class="avatar"><img src="assets/images/avatars/1.jpg" class="avatar-img" alt=""></span>
        <i data-lucide="chevron-down" class="ms-3 opacity-75"></i>
    </a>
    <div class="menu">
        <a class="menu-item" href="pages-profile.html"><i data-lucide="user"></i>My profile</a>
        <a class="menu-item" href="pages-profile.html#interface"><i data-lucide="settings"></i>Interface settings</a>
        <h6 class="menu-header">Workspace</h6>
        <a class="menu-item" href="apps-users.html"><i data-lucide="users"></i>Team members</a>
        <a class="menu-item" href="pages-pricing.html"><i data-lucide="credit-card"></i>Billing</a>
        <hr class="menu-divider">
        <a class="menu-item" href="pages-login.html"><i data-lucide="log-out"></i>Sign out</a>
    </div>
</div>
<div class="d-none 2xl:d-block lh-sm">
    <div class="fw-bold opacity-75 text-nowrap">Alina Mclourd</div>
    <div class="small opacity-50 text-nowrap">VP People Manager</div>
</div>
<button type="button" class="btn-solid btn-icon btn-sm theme-primary shadow-sm shadow-primary d-none 2xl:d-inline-flex" data-aui-toast="#auiCalendarToast" aria-label="Calendar"><i data-lucide="calendar"></i></button>
