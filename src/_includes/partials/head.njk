<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} - {{ description }}</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="favicon.ico">

<link rel="stylesheet" href="{{ cdn.bootstrap.css }}" crossorigin="anonymous">
{%- for name in styles %}
<link rel="stylesheet" href="{{ cdn.styles[name] }}" crossorigin="anonymous">
{%- endfor %}
<link rel="stylesheet" href="architectui.css">
{# Applies saved settings before the first paint: layout attributes, light/dark/system mode and the theme stylesheet.
   The theme link is written with document.write so that it blocks rendering in every browser and the page never flashes in the wrong theme. #}
<script>
(function () {
  var d = document.documentElement, s = {}, m, t;
  try { s = JSON.parse(localStorage.getItem("architectui")) || {}; } catch (e) {}
  if (s.theme === "light" || s.theme === "dark") { s.mode = s.theme; delete s.theme; }
  if (s.theme === "blue") delete s.theme;
  for (var k in s) d.setAttribute("data-aui-" + k, s[k]);
  t = /^[a-z0-9-]+$/.test(s.theme || "") ? s.theme : "";
  m = s.mode || "light";
  if (t) {
    var css = document.querySelector('link[href$="architectui.css"]').getAttribute("href");
    document.write('<link rel="stylesheet" id="aui-theme" href="' + css.replace(/architectui\.css$/, "themes/" + t + ".css") + '">');
    if ((" " + d.getAttribute("data-aui-dark-only") + " ").indexOf(" " + t + " ") > -1) m = "dark";
  }
  if (m === "system") m = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  d.setAttribute("data-bs-theme", m);
})();
</script>

<script defer src="{{ cdn.bootstrap.js }}" crossorigin="anonymous"></script>
<script defer src="{{ cdn.lucide }}" crossorigin="anonymous"></script>
{%- for name in scripts %}
<script defer src="{{ cdn.scripts[name] }}" crossorigin="anonymous"></script>
{%- endfor %}
<script defer src="architectui.js"></script>
{%- if script %}
<script defer src="{{ script }}"></script>
{%- endif %}
