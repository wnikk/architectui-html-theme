<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} - {{ description }}</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="favicon.ico">

<link rel="stylesheet" href="{{ cdn.bootstrap.css }}" crossorigin="anonymous">
{%- for name in styles %}
<link rel="stylesheet" href="{{ cdn.styles[name] }}" crossorigin="anonymous">
{%- endfor %}
{#- ?v= with the package version: a new release reaches visitors past their browser cache #}
<link rel="stylesheet" href="architectui.css?v={{ pkg.version }}">
{# Applies saved settings before the first paint: layout attributes, light/dark/system mode and the theme stylesheet.
   The theme link goes right after architectui.css with blocking="render"; where that attribute is unknown, data-aui-loading
   keeps the page hidden until the link loads (at most 3 s), and the page then fades in. #}
<script>
(function () {
  var d = document.documentElement, s = {}, m, t;
  try { s = JSON.parse(localStorage.getItem("architectui")) || {}; } catch (e) {}
  if (s.theme === "light" || s.theme === "dark") { s.mode = s.theme; delete s.theme; }
  if (s.theme === "blue") delete s.theme;
  t = /^[a-z0-9-]+$/.test(s.theme || "") ? s.theme : "";
  // An empty or unknown value sets no attribute: data-aui-theme="" would switch the built-in Business look off
  for (var k in s) if (s[k] && k !== "theme") d.setAttribute("data-aui-" + k, s[k]);
  if (t) d.setAttribute("data-aui-theme", t);
  m = s.mode || "light";
  if (t) {
    var base = document.querySelector('link[href*="architectui.css"]'), link = document.createElement("link");
    var shown = function () { d.removeAttribute("data-aui-loading"); };
    link.rel = "stylesheet";
    link.id = "aui-theme";
    link.href = base.getAttribute("href").replace(/architectui\.css(\?|$)/, "themes/" + t + ".css$1");
    link.setAttribute("blocking", "render");
    link.onload = link.onerror = shown;
    setTimeout(shown, 3000);
    d.setAttribute("data-aui-loading", "");
    base.parentNode.insertBefore(link, base.nextSibling);
    if ((" " + d.getAttribute("data-aui-dark-only") + " ").indexOf(" " + t + " ") > -1) m = "dark";
  }
  if (m === "system") m = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  d.setAttribute("data-bs-theme", m);
})();
</script>

<script defer src="{{ cdn.bootstrap.js }}" crossorigin="anonymous"></script>
<script defer src="{{ cdn.lucide }}" crossorigin="anonymous"></script>
{%- for name in scripts %}
<script defer src="{{ cdn.scripts[name] }}" crossorigin="anonymous"></script>
{%- endfor %}
{# The guest frame sets themeScript to architectui-auth.js; the admin pages load architectui.js #}
<script defer src="{{ themeScript or "architectui.js" }}?v={{ pkg.version }}"></script>
{%- if script %}
<script defer src="{{ script }}?v={{ pkg.version }}"></script>
{%- endif %}
