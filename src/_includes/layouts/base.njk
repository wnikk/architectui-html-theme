<!doctype html>
<html lang="en" data-aui-header="fixed" data-aui-sidebar="fixed" data-aui-footer="static" data-aui-tabs="shadow" data-aui-dark-only="{% for theme in themes %}{% if theme.darkOnly %}{{ theme.id }} {% endif %}{% endfor %}">
<head>
    {% include "partials/head.njk" %}
</head>
<body>
    <a class="visually-hidden-focusable btn btn-primary aui-skip-link" href="#main">Skip to content</a>
    {% include "partials/icon-gradients.njk" %}
    <div class="aui-app">
        {% include "partials/header.njk" %}
        {% include "partials/sidebar.njk" %}
        <main class="d-flex flex-column" id="main" tabindex="-1">
            <div class="flex-grow-1 aui-content">
                {% include "partials/page-title.njk" %}
                {{ content | safe }}
            </div>
            {% include "partials/footer.njk" %}
        </main>
    </div>
    {% include "partials/toasts.njk" %}
</body>
</html>
