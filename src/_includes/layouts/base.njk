<!doctype html>
<html lang="en" data-aui-header="fixed" data-aui-sidebar="fixed" data-aui-footer="static" data-aui-tabs="shadow" data-aui-dark-only="{% for theme in themes %}{% if theme.darkOnly %}{{ theme.id }} {% endif %}{% endfor %}">
<head>
    {% include "partials/head.njk" %}
    <!--
    =========================================================
    * ArchitectUI HTML Theme Dashboard - v{{ pkg.version }}
    =========================================================
    * Source: https://github.com/wnikk/architectui-html-theme
    * Copyright 2025 DashboardPack
    * Licensed under MIT (https://github.com/wnikk/architectui-html-theme/blob/master/LICENSE)
    =========================================================
    * The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.
    -->
</head>
<body>
    <a class="visually-hidden-focusable btn btn-primary aui-skip-link" href="#main">Skip to content</a>
    {% include "partials/icon-gradients.njk" %}
    <div class="aui-app">
        {% include "partials/header.njk" %}
        {% include "partials/sidebar.njk" %}
        <main class="aui-main" id="main" tabindex="-1">
            <div class="aui-main__inner">
                {% include "partials/page-title.njk" %}
                {{ content | safe }}
            </div>
            {% include "partials/footer.njk" %}
        </main>
    </div>
    {% include "partials/settings.njk" %}
    {% include "partials/toasts.njk" %}
</body>
</html>
