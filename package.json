{
  "name": "architectui-html-free",
  "version": "5.3.1",
  "description": "ArchitectUI - Bootstrap 5 admin dashboard theme: a CSS and ES module layer on top of CDN Bootstrap, Lucide icons, switchable visual themes",
  "author": "DashboardPack.com",
  "homepage": "https://dashboardpack.com",
  "private": false,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:html": "eleventy",
    "build:css": "sass src/scss/architectui.scss:dist/architectui.css src/scss/themes:dist/themes --no-source-map --style=compressed",
    "build": "npm run clean && npm run build:html && npm run build:css",
    "watch:css": "sass --watch src/scss/architectui.scss:dist/architectui.css src/scss/themes:dist/themes --no-source-map --style=compressed",
    "dev": "npm run build:css && (npm run watch:css & eleventy --serve)",
    "start": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wnikk/architectui-html-theme.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "sass": "^1.105.1"
  },
  "license": "MIT"
}
